{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "warp",
  "version": "0.2.9",
  "identifier": "com.warp.launcher",
  "build": {
    "frontendDist": "../dist/warp-ui/browser",
    "devUrl": "http://localhost:4200",
    "beforeDevCommand": "npm start",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warp Launcher",
        "url": "index.html",
        "width": 960,
        "height": 680,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "shortDescription": "Warp Launcher",
    "linux": {
      "deb": {
        "section": "admin",
        "desktopTemplate": "desktop.template"
      },
      "rpm": {
        "desktopTemplate": "desktop.template"
      }
    }
  }
}
